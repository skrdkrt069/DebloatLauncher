<Window x:Class="DebloatLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DW_v0.69"
        Height="500"
        Width="800"
        MinHeight="450"
        MinWidth="650"
        Background="#10141B"
        BorderThickness="1"
        BorderBrush="#1F2937"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        KeyDown="Window_KeyDown"
        Icon="D:\VS Apps\DebloatLauncher\DebloatLauncher\icon.ico">

    <shell:WindowChrome.WindowChrome>

        <shell:WindowChrome 
        CaptionHeight="0"
        ResizeBorderThickness="6"
        CornerRadius="0"
        GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.Background>

            <LinearGradientBrush StartPoint="0,0"
                         EndPoint="1,1">

                <GradientStop Color="#0D1117"
                      Offset="0"/>

                <GradientStop Color="#111827"
                      Offset="1"/>

            </LinearGradientBrush>

        </Grid.Background>

        <!-- Wallpaper -->
        <Border Height="40"
        VerticalAlignment="Top"
        Background="#10141B"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"/>

        <Grid MouseLeftButtonDown="WindowDrag">

            <!-- Sidebar -->
            <Image Source="sidebar_clean.bmp"
           MaxWidth="1600"
           MaxHeight="900"
           Stretch="UniformToFill"
           HorizontalAlignment="Left" Margin="-46,0,0,0"/>

        </Grid>

        <!-- Botão Central -->
        <Button x:Name="LaunchButton"
        Click="LaunchButton_Click"
        Width="82"
        Height="80"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="#00E5FF"
        Foreground="Black"
        FontWeight="Bold"
        BorderThickness="0"
        Cursor="Hand"
        Margin="0,0,0,230">

            <Button.Effect>

                <DropShadowEffect BlurRadius="23"
                          ShadowDepth="0"
                          Color="#00E5FF"
                          Opacity="1.69"/>

            </Button.Effect>

            <Button.Style>
                <Style TargetType="Button">

                    <Setter Property="Background" Value="#00E5FF"/>
                    <Setter Property="Foreground" Value="Black"/>

                    <Style.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#00B8D4"/>
                        </Trigger>

                    </Style.Triggers>

                </Style>

            </Button.Style>

            <!-- Logo do Botão Central -->
            <Image 
                   Source="/Image1.png" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform" Width="92" Height="82">

                <Image.Effect>

                    <DropShadowEffect BlurRadius="0"
                          ShadowDepth="0"
                          Color="#00E5FF"
                          Opacity="0"/>

                </Image.Effect>

            </Image>
        </Button>

        <!-- Texto Para Interagir-->
        <TextBlock x:Name="PressEText"
           Text="Pressione E Para Interagir"
           FontSize="30"
           FontWeight="Bold"
           Foreground="#00E5FF"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="0,426,0,0">

            <TextBlock.Triggers>

                <EventTrigger RoutedEvent="Loaded">

                    <BeginStoryboard>

                        <Storyboard RepeatBehavior="Forever"
                        AutoReverse="True">

                            <DoubleAnimation
                    Storyboard.TargetProperty="Opacity"

                    From="1.69"
                    To="0.35"

                    Duration="0:0:1.69"/>

                        </Storyboard>

                    </BeginStoryboard>

                </EventTrigger>

            </TextBlock.Triggers>

        </TextBlock>

        <!-- Botão Fechar a Janela -->
        <Button x:Name="CloseButton"
        Content="X"
        Width="35"
        Height="32"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Background="#111827"
        Foreground="#00E5FF"
        BorderThickness="0"
        FontWeight="Bold"   
        Click="CloseButton_Click"/>

        <!-- Botão Minimizar -->
        <Button x:Name="MinimizeButton"
        Content="–"
        Width="35"
        Height="32"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Background="#111827"
        Foreground="#00E5FF"
        BorderThickness="0"
        FontSize="20"
        Click="MinimizeButton_Click" 
        Margin="0,0,35,0"/>

        <!-- Caixa de Log -->
        <TextBox x:Name="LogBox"
         Width="420"
         Height="237"
         HorizontalAlignment="Center"
         VerticalAlignment="Top"
         Background="#0A0F14"
         Foreground="#00E5FF"
         BorderBrush="#00E5FF"
         BorderThickness="1"
         FontFamily="Consolas"
         FontSize="20"
         IsReadOnly="True"
         TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto" Margin="0,167,0,0"/>
        
        <!-- Barra de Progresso -->
        <Border x:Name="ProgressBar"
         HorizontalAlignment="Center"
         VerticalAlignment="Bottom"
         Margin="0,0,0,350"
         CornerRadius="4">

            <Border.Effect>

                <DropShadowEffect
                 BlurRadius="18"
                 ShadowDepth="0"
                 Color="#00E5FF"
                 Opacity="0.69"/>

            </Border.Effect>

            <ProgressBar x:Name="CyberProgress"
             Width="320"
             Height="8"
             Minimum="0"
             Maximum="169"
             Value="0"
             Background="#111827"
             Foreground="#00E5FF"/>

        </Border>

    </Grid>

</Window>